# NagarSetu — environment variables
# Copy this file to .env and fill in the values.
# All variables must begin with VITE_ to be exposed to the browser bundle.

# Base URL of the backend API, including any route prefix.
# Must match apiClient.js's fallback so copying this file changes nothing.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: override the default app title shown in the browser tab.
# VITE_APP_TITLE=NagarSetu

# Optional: Google Gemini API key for real image analysis in the browser.
# ⚠️  VITE_ variables are bundled into the frontend — do NOT use production
# keys here. For production, route image analysis through the backend.
# VITE_VISION_API_KEY=your_gemini_api_key_here
